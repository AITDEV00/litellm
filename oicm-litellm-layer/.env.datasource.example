# .env.datasource.example
#
# Copy to `.env.datasource` and fill in the real secret values from the
# deployed `mlops` litellm-proxy (see runbooks/DATASOURCE-LOCAL-VALIDATION.md).
# Used to run a LOCAL litellm against port-forwarded cluster datasources.
#
# Ports match oicm-litellm-layer/scripts/port-forward-datasources.sh.

# Prisma DB via forwarded Postgres (svc/mlops-postgres-rw:5432 -> localhost:5432)
DATABASE_URL=postgresql://litellm:litellm_proxy_2025@127.0.0.1:5432/litellm

# Redis via forwarded service (svc/litellm-redis:6379 -> localhost:16379)
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=litellm-redis-7f3a9b2e

# Prometheus via forwarded service (svc/kube-prometheus-stack-prometheus:9090 -> localhost:9090)
PROMETHEUS_URL=http://127.0.0.1:9090

# Auth / model loading
# LITELLM_MASTER_KEY is exported by `make litellm-local-datasource` from the
# single source of truth (the `litellm-master-key` Secret in
# deploy/litellm-proxy.yaml) before this file is sourced, so it is intentionally
# not set here.
STORE_MODEL_IN_DB=true