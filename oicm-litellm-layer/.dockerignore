# Build context for Dockerfile.postgres. The build needs the supervisor script
# and the Postgres icon, so everything else is excluded to keep the context
# small. Without this, `podman build .` ships the whole layer directory,
# including the venvs and any build artifacts left on disk.
*
!scripts/
!scripts/pg-entrypoint.sh
!scripts/models/
!scripts/models/configure_edge_models.sh
!decor/
!decor/postgres/
!config/
!config/local_postgres.yaml
!.env.edge
